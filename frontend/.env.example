# ─── API ──────────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000/api

# ─── Blockchain ───────────────────────────────────────────────────────────────
REACT_APP_VOTER_IDENTITY_ADDRESS=0x_VoterIdentity_contract_address
REACT_APP_ETHVOTE_ADDRESS=0x_EthVote_contract_address
REACT_APP_CHAIN_ID=31337
# Production: 137 (Polygon Mainnet) or 80002 (Amoy Testnet)

# ─── IPFS ─────────────────────────────────────────────────────────────────────
REACT_APP_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ─── Build / Dev noise ────────────────────────────────────────────────────────
# face-api.js ships sourcemap references to TS sources not published in npm,
# which can create a lot of CRA warnings. Setting this disables sourcemaps.
GENERATE_SOURCEMAP=false

# Optional: liveness face match distance threshold (lower=strict, higher=relaxed)
# Recommended range: 0.58 - 0.66 (default in code: 0.62)
# REACT_APP_FACE_MATCH_MAX_DISTANCE=0.62
