# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ethvote
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ethvote

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_this
JWT_EXPIRE=7d
# Optional: cap auth routes (Aadhaar verify, admin login, etc.) per IP per window; default 80 dev / 10 prod
# AUTH_RATE_LIMIT_MAX=120
# Optional: separate secret for short-lived Aadhaar Offline → register session (defaults to JWT_SECRET)
# KYC_SESSION_SECRET=
# KYC_SESSION_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_also_long
JWT_REFRESH_EXPIRE=30d

# ─── Aadhaar / Sandbox ────────────────────────────────────────────────────────
AADHAAR_HASH_SALT=your_secret_salt_for_aadhaar_hashing_never_share
# For production TSP integration:
# AADHAAR_CLIENT_ID=
# AADHAAR_CLIENT_SECRET=
# AADHAAR_API_BASE_URL=https://api.sandbox.co.in/kyc/v2

# ─── Twilio (Mobile OTP) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cloudinary (Document Storage) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=ethvote_documents

# ─── Blockchain ───────────────────────────────────────────────────────────────
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Production: BLOCKCHAIN_RPC_URL=https://polygon-rpc.com (or Alchemy/Infura URL)

ADMIN_WALLET_PRIVATE_KEY=0xprivate_key_of_backend_admin_wallet_KEEP_SECRET
VOTER_IDENTITY_CONTRACT_ADDRESS=0x_deployed_VoterIdentity_address
ETHVOTE_CONTRACT_ADDRESS=0x_deployed_EthVote_address

# ─── IPFS / Pinata ────────────────────────────────────────────────────────────
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
IDFY_API_KEY=aa704b6b-e7d2-4b64-8def-b6ed23227c3c
IDFY_ACCOUNT_ID=d36fa802869f/4b6a3d67-6438-46d4-993f-15ee1631160a
